# ==============================================================================
# 1. Google Agent Identity (Bootstrap Base Credential)
# ==============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_REGION=us-central1
GOOGLE_AGENT_IDENTITY_SA=entra-agent-runtime-sa@your-gcp-project-id.iam.gserviceaccount.com
GOOGLE_AGENT_IDENTITY_AUDIENCE=api://AzureADTokenExchange

# ==============================================================================
# 2. Google Cloud Workload Identity Federation (WIF / STS)
# ==============================================================================
WIF_POOL_ID=entra-agent-pool
WIF_PROVIDER_ID=entra-oidc-provider

# ==============================================================================
# 3. Microsoft Entra Agent ID (Enterprise Directory Principal)
# ==============================================================================
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AGENT_OBJECT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SCOPE=api://AzureADTokenExchange/.default

# ==============================================================================
# 4. Demo Target Resources & Test Flags
# ==============================================================================
DEMO_GCS_BUCKET=your-gcp-project-id-entra-agent-docs
MOCK_AUTH=false

